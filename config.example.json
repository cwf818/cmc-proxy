    "claude-opus-4-6": "deepseek/deepseek-v4-flash",
    "claude-opus-5": "deepseek/deepseek-v4-flash",
    "claude-haiku-4-5": "deepseek/deepseek-v4-flash",
    "claude-haiku-4-5-20251001": "deepseek/deepseek-v4-flash",
